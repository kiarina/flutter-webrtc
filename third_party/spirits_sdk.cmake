# Downstream integration only. Never fall back to a stock SDK for this branch.
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR CMAKE_GENERATOR_PLATFORM MATCHES "[Aa][Rr][Mm]")
  message(FATAL_ERROR "External-media SDK is available for Windows x64 only")
endif()
get_filename_component(_sdk_parent "${CMAKE_CURRENT_LIST_DIR}" REALPATH)
set(_sdk_cache "${_sdk_parent}/external-media-sdk-20261020.1")
set(SPIRITS_LIBWEBRTC_ROOT "${_sdk_cache}/libwebrtc")
set(_sdk_zip "${_sdk_parent}/downloads/external-media-sdk-windows-x64-20261020.1.zip")
set(_sdk_hash "38388ef11c2a9ee959592c14cbbd5eb88596698c1e2633a52cbfc8dca9b5f5a4")
if(NOT EXISTS "${_sdk_zip}")
  file(MAKE_DIRECTORY "${_sdk_parent}/downloads")
  file(DOWNLOAD
    "https://github.com/kiarina/libwebrtc/releases/download/external-media-sdk-windows-x64-20261020.1/libwebrtc-win-x64-release.zip"
    "${_sdk_zip}" EXPECTED_HASH "SHA256=${_sdk_hash}" STATUS _sdk_status TLS_VERIFY ON)
  list(GET _sdk_status 0 _sdk_code)
  if(NOT _sdk_code EQUAL 0)
    message(FATAL_ERROR "Pinned external-media SDK download failed: ${_sdk_status}")
  endif()
endif()
file(SHA256 "${_sdk_zip}" _sdk_actual)
if(NOT _sdk_actual STREQUAL _sdk_hash)
  message(FATAL_ERROR "Pinned external-media SDK archive hash mismatch; remove only ${_sdk_zip} and retry")
endif()
if(NOT EXISTS "${SPIRITS_LIBWEBRTC_ROOT}")
  file(MAKE_DIRECTORY "${_sdk_cache}")
  file(ARCHIVE_EXTRACT INPUT "${_sdk_zip}" DESTINATION "${_sdk_cache}")
endif()
function(_spirits_sdk_verify relative expected)
  set(_path "${SPIRITS_LIBWEBRTC_ROOT}/${relative}")
  if(NOT EXISTS "${_path}")
    message(FATAL_ERROR "Pinned external-media SDK missing ${relative}")
  endif()
  file(SHA256 "${_path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Pinned external-media SDK hash mismatch: ${relative}; restore ${_sdk_cache} from the verified archive")
  endif()
endfunction()
